; Der Weg des Ritters — Godot rebuild.
;
; The web export is single-threaded on purpose: GitHub Pages cannot send the
; COOP/COEP headers a threaded Godot 4 build needs for SharedArrayBuffer, and
; this game has to stay deployable as static files.

config_version=5

[application]
config/name="Der Weg des Ritters"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
; Expand, not keep. With "keep" the viewport holds the 1280x720 shape and a
; phone in landscape gets black bars down both sides — which is exactly what
; the first build on a real device looked like. Expanding fills the screen and
; anchors the health globe and the ability buttons to the true corners, which
; is where a thumb actually is.
window/stretch/aspect="expand"

[rendering]

; A four-thousand-pixel shadow map is a desktop default and this game opens in
; a phone browser. At the distance the camera can actually see, two thousand
; is indistinguishable.
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=1024
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0

[input_devices]

; Off, and load-bearing. Godot can synthesise mouse events from touch, but
; that emulation is single-pointer: with it on you can steer or you can swing,
; never both, which on an action game is the whole thing. Touch is read
; directly in touch_controls.gd and the mouse is handled on its own.
pointing/emulate_mouse_from_touch=false

[input]
move_left={"deadzone":0.5,"events":[{"resource_local_to_scene":false,"type":"InputEventKey","keycode":65,"physical_keycode":0,"unicode":0,"echo":false,"script":null}]}
move_right={"deadzone":0.5,"events":[{"resource_local_to_scene":false,"type":"InputEventKey","keycode":68,"physical_keycode":0,"unicode":0,"echo":false,"script":null}]}
move_up={"deadzone":0.5,"events":[{"resource_local_to_scene":false,"type":"InputEventKey","keycode":87,"physical_keycode":0,"unicode":0,"echo":false,"script":null}]}
move_down={"deadzone":0.5,"events":[{"resource_local_to_scene":false,"type":"InputEventKey","keycode":83,"physical_keycode":0,"unicode":0,"echo":false,"script":null}]}
cast={"deadzone":0.5,"events":[{"resource_local_to_scene":false,"type":"InputEventKey","keycode":32,"physical_keycode":0,"unicode":0,"echo":false,"script":null}]}
